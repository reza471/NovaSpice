<UserControl
    x:Class="NovaSpice.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="40,12,40,40" Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8"/>

            <Border CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE768;"/>
                        <TextBlock Text="LTspice simulator" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="NovaSpice drives LTspice in batch mode (-b) and reads its .raw and .log results. Leave empty to auto-detect."/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" PlaceholderText="C:\Program Files\ADI\LTspice\LTspice.exe" LostFocus="PathBox_LostFocus"/>
                        <Button Grid.Column="1" Content="Browse…" Click="Browse_Click"/>
                        <Button Grid.Column="2" Content="Auto-detect" Click="Detect_Click"/>
                    </Grid>
                    <TextBlock x:Name="PathStatus" FontSize="12"/>
                    <HyperlinkButton Content="Get LTspice (free, from Analog Devices)" NavigateUri="https://www.analog.com/en/resources/design-tools-and-calculators/ltspice-simulator.html" Padding="0"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE790;"/>
                        <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                    <RadioButtons x:Name="ThemeChoice" SelectionChanged="ThemeChoice_SelectionChanged" MaxColumns="3">
                        <x:String>Dark</x:String>
                        <x:String>Light</x:String>
                        <x:String>Use Windows setting</x:String>
                    </RadioButtons>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE946;"/>
                        <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                    <TextBlock Text="NovaSpice Studio 0.1" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="An independent front-end that uses LTspice as its simulation engine. Not affiliated with or endorsed by Analog Devices. LTspice is a registered trademark of Analog Devices, Inc."/>
                    <TextBlock x:Name="DataDir" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
