<UserControl
    x:Class="NovaSpice.Views.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:NovaSpice.Controls">

    <Grid Padding="12,4,16,12">
        <Grid x:Name="Body" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SchCol" Width="3*"/>
                <ColumnDefinition x:Name="TextCol" Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="SchPanel" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <c:SchematicCanvas x:Name="Sch"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,4" CornerRadius="8"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                    <TextBlock Text="Schematic · wheel = zoom · drag = pan · double-click = probe / fit" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="TextTitle" Text="Netlist" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Dirty" Text="● modified" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed"/>
                </Grid>
                <TextBox x:Name="Code" Grid.Row="1" AcceptsReturn="True" TextWrapping="NoWrap" IsSpellCheckEnabled="False"
                         FontFamily="Cascadia Mono, Consolas" FontSize="13.5" CornerRadius="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         TextChanged="Code_TextChanged"/>
            </Grid>
        </Grid>

        <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <FontIcon Glyph="&#xE943;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            <TextBlock Text="No circuit open" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="Open an .asc schematic or a netlist, or start from a demo on Home."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
