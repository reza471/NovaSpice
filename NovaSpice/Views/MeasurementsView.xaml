<UserControl
    x:Class="NovaSpice.Views.MeasurementsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:NovaSpice.Core">

    <Grid Padding="12,4,16,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="240"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="2">
                <TextBlock Text="Measurements" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock x:Name="Source" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="ErrBadge" CornerRadius="10" Padding="10,3" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="Collapsed">
                    <TextBlock x:Name="ErrText" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                </Border>
                <Border x:Name="WarnBadge" CornerRadius="10" Padding="10,3" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="Collapsed">
                    <TextBlock x:Name="WarnText" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                </Border>
                <Button Content="Copy as table" Click="Copy_Click" CornerRadius="8"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" CornerRadius="12" Padding="12,10"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Padding="12,0,12,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="NAME" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Grid.Column="1" Text="STEP" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Grid.Column="2" Text="EXPRESSION" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Grid.Column="3" Text="VALUE" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Grid.Column="4" Text="DETAILS" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Grid>
            <ListView x:Name="List" Grid.Row="1" SelectionMode="Single" Margin="-4,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:Measurement">
                        <Grid ColumnSpacing="12" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind StepText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind Expr}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind Display}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind Details}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="NoMeas" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="No .meas results yet. Add .meas statements to your circuit and run it — the results appear here."/>
        </Grid>

        <Grid Grid.Row="2" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Simulation log" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" CornerRadius="12"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </Grid>
</UserControl>
